import os
import sys
from PyQt5.QtWidgets import (
    QApplication, QMainWindow, QVBoxLayout, QHBoxLayout, QWidget,
    QPushButton, QLabel, QListWidget, QComboBox, QTextEdit, QStackedWidget, QLineEdit, QInputDialog
)
from PyQt5.QtGui import QFont
from PyQt5.QtCore import Qt
from VoiceControls import VoiceControls
from Transcription import transcribe_audio
from session_management import SessionManager

class TherapyApp(QMainWindow):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("CFS Session Documentor")
        self.setGeometry(100, 100, 1400, 900)

        # Instances
        self.voice_control = VoiceControls()
        self.session_manager = SessionManager()

        # UI Setup
        self.init_ui()

    def init_ui(self):
        # Central widget
        central_widget = QWidget()
        self.setCentralWidget(central_widget)

        # Main layout
        main_layout = QVBoxLayout()
        central_widget.setLayout(main_layout)

        # Top layout (Sidebar + Main content)
        top_layout = QHBoxLayout()

        # Sidebar
        sidebar_container = QWidget()
        sidebar_layout = QVBoxLayout(sidebar_container)
        sidebar_container.setStyleSheet("background-color: #2b2d42; padding: 20px;")
        sidebar_layout.setSpacing(10)

        self.dashboard_button = self.create_sidebar_button("Dashboard", 0)
        self.notes_button = self.create_sidebar_button("Notes", 1)
        self.settings_button = self.create_sidebar_button("Settings", 2)

        sidebar_layout.addWidget(self.dashboard_button)
        sidebar_layout.addWidget(self.notes_button)
        sidebar_layout.addWidget(self.settings_button)
        sidebar_layout.addStretch()

        top_layout.addWidget(sidebar_container, 1)

        # Main content area (stacked views)
        self.stacked_widget = QStackedWidget()

        # Dashboard View
        self.dashboard_view = self.create_dashboard_view()
        self.stacked_widget.addWidget(self.dashboard_view)

        # Notes View
        self.notes_view = self.create_notes_view()
        self.stacked_widget.addWidget(self.notes_view)

        # Settings View
        self.settings_view = self.create_settings_view()
        self.stacked_widget.addWidget(self.settings_view)

        top_layout.addWidget(self.stacked_widget, 4)

        # Add top layout to main layout
        main_layout.addLayout(top_layout)

        # Bottom controls
        bottom_controls = QHBoxLayout()

        self.start_button = self.create_control_button("Start Recording", self.start_recording)
        self.stop_button = self.create_control_button("Stop Recording", self.stop_recording)
        self.save_button = self.create_control_button("Save Session", self.save_session)
        self.delete_button = self.create_control_button("Delete Session", self.delete_session)
        self.transcript_button = self.create_control_button("Generate Transcript", self.generate_transcript)

        bottom_controls.addWidget(self.start_button)
        bottom_controls.addWidget(self.stop_button)
        bottom_controls.addWidget(self.save_button)
        bottom_controls.addWidget(self.delete_button)
        bottom_controls.addWidget(self.transcript_button)

        main_layout.addLayout(bottom_controls)

    def create_sidebar_button(self, text, view_index):
        button = QPushButton(text)
        button.setStyleSheet("QPushButton { color: white; background-color: #6c63ff; border: none; padding: 15px; font-size: 16px; border-radius: 5px; }"
                             "QPushButton:hover { background-color: #48cae4; }")
        button.clicked.connect(lambda: self.stacked_widget.setCurrentIndex(view_index))
        return button

    def create_control_button(self, text, callback):
        button = QPushButton(text)
        button.setStyleSheet("QPushButton { color: white; background-color: #5a5cbb; border: none; padding: 10px; font-size: 14px; border-radius: 5px; }"
                             "QPushButton:hover { background-color: #4a47a3; }")
        button.clicked.connect(callback)
        return button

    def create_dashboard_view(self):
        view = QWidget()
        layout = QVBoxLayout()

        self.status_label = QLabel("Status: Idle")
        self.status_label.setFont(QFont("Arial", 14, QFont.Bold))
        self.status_label.setAlignment(Qt.AlignCenter)
        self.status_label.setStyleSheet("background-color: #6c63ff; color: white; padding: 10px; border-radius: 10px;")

        self.client_name_input = QLineEdit()
        self.client_name_input.setPlaceholderText("Enter Client Name")
        self.client_name_input.setStyleSheet("padding: 10px; border: 1px solid #ccc; border-radius: 5px;")

        self.session_topic_input = QLineEdit()
        self.session_topic_input.setPlaceholderText("Enter Session Topic")
        self.session_topic_input.setStyleSheet("padding: 10px; border: 1px solid #ccc; border-radius: 5px;")

        self.session_list = QListWidget()
        self.session_list.setStyleSheet("QListWidget { border: 1px solid #ddd; border-radius: 5px; padding: 10px; background-color: #f7f9fc; }")
        self.update_saved_sessions()

        self.transcript_text = QTextEdit()
        self.transcript_text.setPlaceholderText("Transcript will appear here...")
        self.transcript_text.setReadOnly(True)
        self.transcript_text.setStyleSheet("background-color: #edf2f4; border: 1px solid #ddd; padding: 10px; border-radius: 5px;")

        layout.addWidget(self.status_label)
        layout.addWidget(QLabel("Client Name:"))
        layout.addWidget(self.client_name_input)
        layout.addWidget(QLabel("Session Topic:"))
        layout.addWidget(self.session_topic_input)
        layout.addWidget(QLabel("Saved Sessions:"))
        layout.addWidget(self.session_list)
        layout.addWidget(QLabel("Transcript:"))
        layout.addWidget(self.transcript_text)

        view.setLayout(layout)
        return view

    def create_notes_view(self):
        view = QWidget()
        layout = QVBoxLayout()

        self.notes_type_selector = QComboBox()
        self.notes_type_selector.addItems(["SOAP", "DAP", "BIRP", "GIRP"])
        self.notes_text_edit = QTextEdit()
        self.notes_text_edit.setPlaceholderText("Write your notes here...")

        layout.addWidget(QLabel("Select Note Type:"))
        layout.addWidget(self.notes_type_selector)
        layout.addWidget(QLabel("Notes:"))
        layout.addWidget(self.notes_text_edit)

        view.setLayout(layout)
        return view

    def create_settings_view(self):
        view = QWidget()
        layout = QVBoxLayout()

        self.mic_selector = QComboBox()
        self.populate_mic_list()
        layout.addWidget(QLabel("Select Microphone:"))
        layout.addWidget(self.mic_selector)

        view.setLayout(layout)
        return view

    def populate_mic_list(self):
        mics = self.voice_control.get_available_microphones()
        for index, name in mics:
            self.mic_selector.addItem(name, index)

    def update_saved_sessions(self):
        self.session_list.clear()
        sessions = self.session_manager.get_all_sessions()
        for session in sessions:
            self.session_list.addItem(session)

    def start_recording(self):
        mic_index = self.mic_selector.currentData()
        if mic_index is None:
            self.status_label.setText("Status: Please select a microphone.")
            return

        if self.voice_control.start_recording(mic_index):
            self.status_label.setText("Status: Recording...")
        else:
            self.status_label.setText("Status: Failed to start recording.")

    def stop_recording(self):
        if self.voice_control.stop_recording():
            self.status_label.setText("Status: Recording stopped.")
        else:
            self.status_label.setText("Status: Failed to stop recording.")

    def save_session(self):
        client_name = self.client_name_input.text().strip()
        session_topic = self.session_topic_input.text().strip()

        if not client_name or not session_topic:
            self.status_label.setText("Status: Please enter valid client name and session topic.")
            return

        audio_data = b"".join(self.voice_control.frames)
        session_folder = self.session_manager.save_session(client_name, session_topic, audio_data)
        if session_folder:
            self.update_saved_sessions()
            self.status_label.setText(f"Status: Session saved at {session_folder}.")
        else:
            self.status_label.setText("Status: Failed to save session.")

    def delete_session(self):
        selected_item = self.session_list.currentItem()
        if not selected_item:
            self.status_label.setText("Status: Please select a session to delete.")
            return

        session_folder = selected_item.text()
        if self.session_manager.delete_session(session_folder):
            self.update_saved_sessions()
            self.status_label.setText(f"Status: Deleted session {session_folder}.")
        else:
            self.status_label.setText("Status: Failed to delete session.")

    def generate_transcript(self):
        selected_item = self.session_list.currentItem()
        if not selected_item:
            self.status_label.setText("Status: Please select a session to transcribe.")
            return

        session_folder = selected_item.text()
        audio_path = self.session_manager.get_session_audio_path(session_folder)
        if not audio_path:
            self.status_label.setText("Status: Audio file not found for selected session.")
            return

        transcript = transcribe_audio(audio_path)
        if transcript:
            self.transcript_text.setText(transcript)
            self.status_label.setText(f"Status: Transcript generated for {session_folder}.")
        else:
            self.status_label.setText("Status: Failed to generate transcript.")

    def closeEvent(self, event):
        self.voice_control.terminate()
        event.accept()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setStyleSheet("QMainWindow { background-color: #e5e9f0; }")
    window = TherapyApp()
    window.show()
    sys.exit(app.exec_())
